# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/datasense_ai

# AI Provider (choose one)
# For OpenAI (GPT-4): Use key starting with "sk-"
# For Google Gemini: Use key starting with "AIza" from https://ai.google.dev/
OPENAI_API_KEY=your-api-key-here

# App
APP_NAME=DataSense AI
DEBUG=True

# Storage
UPLOAD_DIR=./uploads
